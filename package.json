{
  "name": "indruk",
  "version": "1.0.0",
  "description": "Lines of code in any checkout, split into production and test code per workspace package, with comments, complexity and a word count of the docs.",
  "keywords": [
    "loc",
    "lines-of-code",
    "scc",
    "monorepo",
    "test-coverage"
  ],
  "license": "MIT",
  "author": "Thijs Koerselman",
  "homepage": "https://github.com/0x80/indruk#readme",
  "bugs": {
    "url": "https://github.com/0x80/indruk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0x80/indruk.git"
  },
  "bin": {
    "indruk": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-mdx": "^3.0.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-mdxjs": "^3.0.0",
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "tsdown": "^0.16.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.18.0"
}
